# Build artifacts
/target/
**/target/

# Ad-hoc Rust experiment outputs (per repo convention)
/rust_out
/rust_test
*_test_exe
Cargo.toml.tmp

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
.env.*.local
.env.test
docker/docker-compose.override.yml
*.log

# Certificates and keys (never commit these)
*.pem
!*.example.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
ca_key.pem
ca_key_test.pem

# OS
.DS_Store
Thumbs.db

# Test coverage
*.prof
*.sym
*.pdb

# Fuzz testing outputs (cargo-fuzz creates corpus, artifacts in project root)
**/fuzz/**/corpus/
**/fuzz/**/artifacts/
**/fuzz/**/crash-*
**/fuzz/slow-unit-*
**/fuzz/**/*.options
**/fuzz/**/*.launcher
**/fuzz/**/target/

# docs output (generated)
docs/book/

/evaluation/

# SBOM (regenerate with: cargo cyclonedx --format json)
*.cdx.json

# Cargo.lock — library workspace; consumers resolve their own versions, so not committed
Cargo.lock

# ---------------------------------------------------------------------------
# Interop testing artifacts (defense-in-depth — never commit these)
# ---------------------------------------------------------------------------
# Tongsuo build artifacts under gm-tlcp/interop/. The .gitignore inside
# that directory already covers this; these top-level patterns are a
# backstop in case someone accidentally inits git in a subdirectory
# with a different .gitignore scope, or moves files around.
**/Tongsuo-*/
**/tongsuo-bin/
**/Tongsuo-*.tar.gz
**/interop/run/

# ---------------------------------------------------------------------------
# Internal process artifacts (workflow-internal scratch, not for publishing)
# ---------------------------------------------------------------------------
# Excludes per-cycle R-* plan / status / submission records / draft files.
# Canonical reproducible artifacts (AUDIT-*.md, F4-DIAGNOSTIC-*.md,
# R*-1-DIAGNOSTIC.sh) are NOT excluded — those are evidence files that
# belong in the repo. Only workflow-internal scratch files are excluded.
**/interop/R*-PLAN.md
**/interop/R*-*-PLAN.md
**/interop/R*-STATUS-RECORD.md
**/interop/R*-SUBMISSION-RECORD.md
**/interop/R*-ISSUE-DRAFT.md
**/interop/*-VERIFY-*.md
**/tongsuo/upstream/R*-VERIFY-*.md
**/tongsuo/upstream/R*-*-VERIFY-*.md
